  "directories": {
    "doc": "docs"
  },
  "main": "reindex.js",
  "name": "catalina-starches",
  "private": true,
  "scripts": {
    "build": "npm run precompile:templates",
    "pagefind:fallback": "find docs/pagefind -type f \\( -name '*.pagefind' -o -name '*.pf_meta' -o -name '*.pf_fragment' -o -name '*.pf_index' -o -name '*.pf_filter' \\) | while read f; do base64 -w0 \"$f\" > \"${f}.txt\" && echo \"Created ${f}.txt\"; done",
    "build:full": "npm run fetch:all && npm run build && hugo --minify",
    "cy:open": "cypress open",
    "cy:run": "cypress run --config baseUrl=http://127.0.0.1:1313",
    "dev": "HUGO_MODULE_WORKSPACE=hugo.work dotenv -e .env -- hugo server -D --bind=127.0.0.1 --port=1313",
    "fetch:content": "dotenv -e .env -- npx ts-node utils/fetch-content.ts",
    "fetch:prebuild": "dotenv -e .env -- npx ts-node utils/fetch-prebuild.ts",
    "precompile:templates": "npx starches-builder precompileTemplates",
    "preview": "dotenv vite preview",
    "reindex": "dotenv -- bash -c 'rm -f prebuild/preindex/* docs/definitions/business_data/* && for data in prebuild/business_data/*; do echo DATA $data; dotenv -- node --loader ts-node/esm/transpile-only utils/preindex.ts $data; done && dotenv -- node --loader ts-node/esm/transpile-only utils/reindex.ts'",
    "start": "dotenv -e .env -- hugo server -D --bind=127.0.0.1 --port=1313",
    "start:fetch": "npm run fetch:all && npm run start",
    "start:local": "SKIP_BLOB_FETCH=true dotenv -e .env -- hugo server -D --bind=127.0.0.1 --port=1313",
    "start:prod": "SKIP_BLOB_FETCH=true dotenv -e .env -- hugo server --environment production --bind=127.0.0.1 --port=1313",
    "test": "npm run test:lint:css && npm run test:cy:dev",
    "test:coverage": "vitest --coverage",
    "test:cy:dev": "start-server-and-test start http://127.0.0.1:1313 cy:run",
    "test:lint:css": "stylelint \"{static,themes}/**/*.css\" --allow-empty-input",
    "test:ui": "vitest --ui",
    "vite-test": "vitest"
  },
  "version": "0.0.4"
}
